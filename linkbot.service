[Unit]
Description=Telegram link checker bot
After=network-online.target
Wants=network-online.target

[Service]
User=linkbot
WorkingDirectory=/opt/linkbot
EnvironmentFile=/opt/linkbot/.env
ExecStart=/opt/linkbot/venv/bin/python bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
